const express = require("express");
const router = express.Router();

// TODO: Password Reset Implementation
// 1. POST /auth/reset-password - Request password reset (send OTP)
// 2. POST /auth/reset-password/verify - Verify OTP and create reset session
// 3. POST /auth/reset-password/new - Set new password using reset session

// POST /auth/reset-password
router.post("/", async (req, res) => {
  try {
    const { email, recaptchaToken } = req.body;

    // ✅ 1. Required fields
    if (!email || !recaptchaToken) {
      return res.status(400).json({
        error: "MISSING_FIELDS",
        message: "Email and reCAPTCHA token are required."
      });
    }

    // ✅ 2. Basic email format
    const basicEmailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!basicEmailRegex.test(email)) {
      return res.status(400).json({
        error: "INVALID_EMAIL_FORMAT",
        message: "Email format is invalid."
      });
    }

    // ✅ 3. Institutional email validation
    const { detectRoleFromEmail } = require('../../config/validator.js');
    const declaredRole = detectRoleFromEmail(email);
    if (!declaredRole) {
      return res.status(400).json({
        error: "INVALID_INSTITUTION_EMAIL",
        message: "Email must follow TIP institutional format."
      });
    }

    // ✅ 4. Verify reCAPTCHA
    const { verifyRecaptcha } = require('../../services/recaptcha.js');
    const recaptchaValid = await verifyRecaptcha(recaptchaToken);
    if (!recaptchaValid) {
      return res.status(400).json({
        error: "INVALID_RECAPTCHA",
        message: "reCAPTCHA verification failed."
      });
    }

    // ✅ 5. Check if user exists
    const { detectPortalFromSubdomain } = require('../utils/portal.js');
    const portal = detectPortalFromSubdomain(req);
    const pool = require('../../config/db.js');
    const tableName = portal === "patient" ? "patients" : "staff";
    const userQuery = `SELECT id FROM ${tableName} WHERE email = $1`;
    const userResult = await pool.query(userQuery, [email]);

    if (userResult.rows.length === 0) {
      return res.status(404).json({
        error: "USER_NOT_FOUND",
        message: "No account found with this email address."
      });
    }

    // ✅ 6. Rate limiting (simplified)
    const { rateLimitEmailCooldown, rateLimitEmailAttempts } = require('../../config/redis.js');
    const { rateLimitMatrix } = require('../../config/data/matrix.js');
    const profileName = portal === "patient" ? "PatientAuthentication" : "staffAuthentication";
    const profile = rateLimitMatrix[profileName];
    const purpose = "passwordReset";

    const cooldownActive = await rateLimitEmailCooldown(email, portal, purpose, profile.emailCooldown_emailv);
    if (cooldownActive) {
      return res.status(429).json({
        error: "EMAIL_COOLDOWN_ACTIVE",
        message: "Too many attempts. Please try again later."
      });
    }

    const attemptsExceeded = await rateLimitEmailAttempts(
      email, portal, purpose, profile.emailAttemptMax_emailv, profile.emailCooldown_emailv
    );
    if (attemptsExceeded) {
      return res.status(429).json({
        error: "EMAIL_ATTEMPT_LIMIT_REACHED",
        message: "Too many attempts. Please try again later."
      });
    }

    // ✅ 7. Send password reset email
    const { enqueuePasswordResetEmail } = require('../../services/emailservice.js');
    await enqueuePasswordResetEmail(email, portal);

    return res.status(200).json({
      ok: true,
      message: "Password reset OTP sent to your email."
    });

  } catch (err) {
    console.error("Password reset request error:", err);
    return res.status(500).json({
      error: "SERVER_ERROR",
      message: "An unexpected error occurred."
    });
  }
});

// POST /auth/reset-password/verify
router.post("/verify", async (req, res) => {
  try {
    const { email, otp } = req.body;

    // ✅ 1. Required fields
    if (!email || !otp) {
      return res.status(400).json({
        error: "MISSING_FIELDS",
        message: "Email and OTP are required."
      });
    }

    // ✅ 2. Basic email format
    const basicEmailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!basicEmailRegex.test(email)) {
      return res.status(400).json({
        error: "INVALID_EMAIL_FORMAT",
        message: "Email format is invalid."
      });
    }

    // ✅ 3. Institutional email validation
    const { detectRoleFromEmail } = require('../../config/validator.js');
    const declaredRole = detectRoleFromEmail(email);
    if (!declaredRole) {
      return res.status(400).json({
        error: "INVALID_INSTITUTION_EMAIL",
        message: "Email must follow TIP institutional format."
      });
    }

    // ✅ 4. Verify OTP
    const { detectPortalFromSubdomain } = require('../utils/portal.js');
    const { verifyOTP, getOTPFailureCount, getOTPLockoutTTL,
            deleteEmailCooldown, deleteEmailAttempts, createVerificationSession } = require('../../config/redis.js');
    const portal = detectPortalFromSubdomain(req);
    const code = "passwordReset";

    const result = await verifyOTP(email, code, otp, portal);

    // ✅ 5. Handle OTP verification results
    if (result === "LOCKED_OUT") {
      const failures = await getOTPFailureCount(email, code);
      const ttl = await getOTPLockoutTTL(email, code);

      return res.status(429).json({
        error: "OTP_LOCKED_OUT",
        message: "Too many invalid attempts. Please try again later.",
        attempts: failures,
        attemptLimit: Number(process.env.OTP_GLOBAL_ATTEMPT_LIMIT),
        retryAfterSeconds: ttl
      });
    }

    if (result === false) {
      const failures = await getOTPFailureCount(email, code);

      return res.status(400).json({
        error: "INVALID_OTP",
        message: "The OTP you entered is invalid or expired.",
        attempts: failures,
        attemptLimit: Number(process.env.OTP_GLOBAL_ATTEMPT_LIMIT)
      });
    }

    // ✅ 6. OTP valid - create reset session
    await deleteEmailCooldown(email, portal, "passwordReset");
    await deleteEmailAttempts(email, portal, "passwordReset");
    const resetKey = await createVerificationSession(email, "passwordReset", portal);

    return res.status(200).json({
      ok: true,
      message: "OTP verified successfully.",
      resetKey
    });

  } catch (err) {
    console.error("Password reset verify error:", err);
    return res.status(500).json({
      error: "SERVER_ERROR",
      message: "An unexpected error occurred."
    });
  }
});

// POST /auth/reset-password/new
router.post("/new", async (req, res) => {
  try {
    const { resetKey, newPassword } = req.body;

    // ✅ 1. Required fields
    if (!resetKey || !newPassword) {
      return res.status(400).json({
        error: "MISSING_FIELDS",
        message: "Reset key and new password are required."
      });
    }

    // ✅ 2. Password validation
    if (newPassword.length < 8) {
      return res.status(400).json({
        error: "INVALID_PASSWORD",
        message: "Password must be at least 8 characters long."
      });
    }

    // ✅ 3. Get reset session
    const { getVerificationSession, deleteVerificationSession } = require('../../config/redis.js');
    const session = await getVerificationSession(resetKey);
    if (!session) {
      return res.status(401).json({
        error: "INVALID_RESET_KEY",
        message: "Reset key is invalid or expired."
      });
    }

    const { email, purpose, account_type } = session;

    // ✅ 4. Validate purpose
    if (purpose !== "passwordReset") {
      return res.status(401).json({
        error: "INVALID_RESET_SESSION",
        message: "This reset session is not valid for password reset."
      });
    }

    // ✅ 5. Hash and update password
    const { hashPassword } = require('../../config/security.js');
    const hashedPassword = await hashPassword(newPassword);

    const pool = require('../../config/db.js');
    const tableName = account_type === "patient" ? "patients" : "staff";
    const updateQuery = `UPDATE ${tableName} SET password = $1 WHERE email = $2`;
    await pool.query(updateQuery, [hashedPassword, email]);

    // ✅ 6. Delete reset session
    await deleteVerificationSession(resetKey);

    return res.status(200).json({
      ok: true,
      message: "Password reset successfully."
    });

  } catch (err) {
    console.error("Password reset new error:", err);
    return res.status(500).json({
      error: "SERVER_ERROR",
      message: "An unexpected error occurred."
    });
  }
});

module.exports = router;

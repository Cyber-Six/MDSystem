{
  "private": true,
  "workspaces": [
    "packages/*",
    "mds-patient",
    "mds-staff"
  ],
  "scripts": {
    "postinstall": "cd Backend && npm install",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:backend": "jest --runInBand --selectProjects backend",
    "test:backend:coverage": "jest --runInBand --config Backend/jest.config.js --coverage",
    "test:patient": "jest --runInBand --selectProjects patient",
    "test:staff": "jest --runInBand --selectProjects staff",
    "test:mobile": "jest --runInBand --selectProjects mobile",
    "build": "npm run build:patient && npm run build:staff",
    "build:patient": "npm run build --workspace=mds-patient",
    "build:staff": "npm run build --workspace=mds-staff",
    "dev:patient": "npm run dev --workspace=mds-patient",
    "dev:staff": "npm run dev --workspace=mds-staff",
    "start:patient": "node Backend/server.js",
    "start:staff": "node Backend/staff.js"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.27.4",
    "@rollup/rollup-linux-arm64-gnu": "^4.59.0",
    "@rollup/rollup-linux-arm64-musl": "^4.59.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-linux-x64-musl": "^4.59.0",
    "@rollup/rollup-win32-arm64-msvc": "^4.59.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "package-name": "^0.1.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}

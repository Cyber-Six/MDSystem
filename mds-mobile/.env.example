# ─────────────────────────────────────────────────────────────────────────────
# MDSystem Mobile — Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────
# Variables prefixed with EXPO_PUBLIC_ are bundled into the JS bundle and
# are accessible in app code via process.env.EXPO_PUBLIC_*.
# Variables WITHOUT the prefix are only available at build-time (app.config.js).
#
# Versioning convention:
#   v{major}.{minor}.{patch}-{channel}
#   Channels: dev | alpha | beta | rc | (none for stable)
#   Examples: v0.7.5-dev  v0.8.0-beta  v0.9.0-rc  v1.0.0
# ─────────────────────────────────────────────────────────────────────────────

# ── App Environment ───────────────────────────────────────────────────────────
# Options: development | staging | production
APP_ENV=

# Build-time app version (shown on about/settings screens, sent in headers)
APP_VERSION=

# ── Expo Public (runtime-accessible) ─────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_APP_VERSION=

# Backend REST + GraphQL base URL (no trailing slash)
EXPO_PUBLIC_API_URL=

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" / "false"
EXPO_PUBLIC_ENABLE_HEALTH_CHAT=
EXPO_PUBLIC_ENABLE_EMR=
EXPO_PUBLIC_ENABLE_MEDICINE_REQUEST=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Google OAuth Client ID for Google Sign-In (tip.edu.ph accounts)
# Obtain from Google Cloud Console → APIs & Services → Credentials
# Must be the Web or Android/iOS client ID depending on platform
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

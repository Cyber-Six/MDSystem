# AI Medical Chatbot Environment Variables
# Add these to your existing Backend/.env file

# ============================================
# LLaMA Server Configuration
# ============================================

# Host where llama.cpp server is running
LLAMA_SERVER_HOST=localhost

# Port for llama.cpp server
LLAMA_SERVER_PORT=8080

# Whether to auto-start llama.cpp server (recommended: false for stability)
# Set to 'true' to let Node.js spawn llama-server automatically
# Set to 'false' to manually start llama-server in a separate terminal
AUTO_START_LLAMA=false

# ============================================
# Optional: Custom Model Path
# ============================================

# Uncomment to override default model path
# Default: Backend/mds-chatbot/models-storage/Meta-Llama-3-8B-Instruct.Q4_K_M.gguf
# LLAMA_MODEL_PATH=/custom/path/to/your/model.gguf

# ============================================
# Notes
# ============================================

# 1. Make sure llama.cpp is installed and llama-server is accessible
# 2. Download the model file and place it in models-storage/
#    wget https://huggingface.co/QuantFactory/Meta-Llama-3-8B-Instruct-GGUF/resolve/main/Meta-Llama-3-8B-Instruct.Q4_K_M.gguf
# 3. If AUTO_START_LLAMA=false, start llama-server manually before backend
# 4. The model file should be around 4.9GB for Q4_K_M quantization

# ==========================    
# E-Consultation AI Environment
# ==========================

# LLaMA Server Configuration
LLAMA_SERVER_HOST=localhost
LLAMA_SERVER_PORT=8080

# On-Demand AI Service (recommended for resource efficiency)
# Set to 'true' to auto-start AI server when first chat request comes
# Set to 'false' to use external mdsystem-ai.service
AUTO_START_LLAMA=true

# Idle Timeout (minutes)
AI_IDLE_TIMEOUT_MINUTES=20

# Model Path (Raspberry Pi)
LLAMA_MODEL_PATH=~/Models/llama.cpp/models/Phi-3-mini-4k-instruct-Q4_K_M.gguf

# LLaMA Server Binary Path
LLAMA_SERVER_BIN=~/Models/llama.cpp/build/bin/llama-server

# Number of threads (leave 1 for website)
LLAMA_THREADS=3

# MDSystem environment template. Copy to .env and replace secrets before use.
# Compose overrides HOST and database/Redis hostnames inside containers.

# --- Docker and network ---
NODE_ENV=production
HOST=0.0.0.0
PATIENT_PORT=3000
MEDICAL_PORT=3001
GENERATE_DOCX_PORT=3002
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mdsystem
POSTGRES_USER=mdsadmin
POSTGRES_PASSWORD=
POSTGRES_MAX_CONN=10
# Absolute path to complete plain-SQL schema; use forward slashes on Windows.
SCHEMA_SQL_PATH=D:/secure/mdsystem/schema.psql
POST_BUILD_SETUP_SQL_PATH=/app/Backend/config/data/post_build_setup.sql
ADMIN_EMAIL=mdsystem@tip.edu.ph
# bcrypt hash only; never put a plaintext password here
ADMIN_PASSWORD_HASH=$$2b$$12$$U0ZFsviKFb2Y9G.pOG682etc7E5lllqQkRIgduEPcoSxrLGngjZh6
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=mdsadmin
REDIS_PASSWORD=
STAFF_PORT=3001

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_DELAY=1000
EMAIL_2FA_EXPIRATION=300
EMAIL_VERIF_EXPIRATION=600
EMAIL_PASSWD_RESET_EXPIRATION=900

# --- Authentication and encryption ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1d
JWT_PATIENT_ACCESS_EXPIRATION=604800
JWT_STAFF_ACCESS_EXPIRATION=604800
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=mdsystem-auth
TOTP_ENCRYPTION_KEY=
RESET_PASSWORD_DOMAIN_ROUTE=https://www.mdsystemtip.space/auth/password/reset-password

# --- Browser access and sockets ---
# Comma-separated exact origins; avoid wildcard origins in production.
CORS_ALLOWED_ORIGINS=https://www.mdsystemtip.space,https://staff.mdsystemtip.space
# Comma-separated exact origins; avoid wildcard origins in production.
SOCKET_CORS_ORIGIN=https://www.mdsystemtip.space,https://staff.mdsystemtip.space
SOCKET_CORS_METHODS=GET,POST
SOCKET_PATH=
SOCKET_SESSION_TTL=3600
SOCKET_ACK_TIMEOUT_MS=

# --- OAuth and reCAPTCHA ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
RECAPTCHA_SECRET_KEY=
RECAPTCHA_FAIL_ATTEMPT_THRESHOLD=2
RECAPTCHA_TRIGGER_THRESHOLD=0.5
RECAPTCHA_MOBILE_SECRET=
RECAPTCHA_TEST_MODE=false

# --- Patient authentication limits ---
PATIENT_AUTH_RATE_LIMIT_WINDOW=60
PATIENT_AUTH_RATE_LIMIT_MAX_REQUESTS=40
PATIENT_FAILED_LOGIN_THRESHOLD=5
PATIENT_LOGIN_FAIL_TTL=30
PATIENT_LOGIN_FAIL_LOCKDOWN_SECONDS=30
PATIENT_EMAIL_COOLDOWN_2FA=5
PATIENT_EMAIL_ATTEMPTS_2FA=5
PATIENT_EMAIL_COOLDOWN_EMAILV=5
PATIENT_EMAIL_ATTEMPTS_EMAILV=5

# --- Staff authentication limits ---
STAFF_AUTH_RATE_LIMIT_WINDOW=45
STAFF_AUTH_RATE_LIMIT_MAX_REQUESTS=30
STAFF_FAILED_LOGIN_THRESHOLD=3
STAFF_LOGIN_FAIL_TTL=30
STAFF_LOGIN_FAIL_LOCKDOWN_SECONDS=30
STAFF_EMAIL_COOLDOWN_2FA=30
STAFF_EMAIL_ATTEMPTS_2FA=2
STAFF_EMAIL_COOLDOWN_EMAILV=30
STAFF_EMAIL_ATTEMPTS_EMAILV=2

# --- Other rate limits and OTP protection ---
GENERIC_ROUTE_RATE_LIMIT_WINDOW=60
GENERIC_ROUTE_RATE_LIMIT_MAX_REQUESTS=30
STRICT_RATE_LIMIT_WINDOW=
STRICT_RATE_LIMIT_MAX_REQUESTS=
OTP_GLOBAL_ATTEMPT_LIMIT=100
OTP_GLOBAL_LOCKOUT_SECONDS=3600
VERIFICATION_SESSION_EXPIRATION=900

# --- Notifications and workflow ---
NOTIF_MAX_PENDING=100
NOTIF_PENDING_TTL=604800
DATA_CONSENT_VERSION="v1.0"
UPDATE_TICKET_EXPIRY_SEC=604800
MAX_SCHEDULING_DAYS=7
ALLOW_MEDICAL_CREATION_FOR_NON_EMPLOYEES=false
ALLOW_BOOTSTRAP_ADMIN=false
ADMIN_TRANSFER_COOLDOWN=5
ADMIN_TRANSFER_PASSWORD_FAIL_TTL=5
ADMIN_TRANSFER_PASSWORD_FAIL_THRESHOLD=5
ADMIN_TRANSFER_PASSWORD_FAIL_LOCKOUT=10

# --- Media, chatbot, and logging ---
MEDIA_PATH=./../../media
MEDIA_SIZE_MB=50
MEDIA_MAX_FILES_STAGING=5
MEDIA_MAX_FILES_STAGING_EXP=300
CHATBOT_URL=
CHATBOT_API_KEY=
CHATBOT_PROXY_TIMEOUT_MS=
LOGGER_DIR=./../../logs
LOG_LEVEL=debug

# --- External APIs and document service ---
CLIENT_ID=
CLIENT_SECRET=
ICD_RELEASE="2026-01"
DOCX_GENERATED_PORT=8000
DOCX_SERVICE_HOST=127.0.0.1
TEMPLATE_PATH="services/docx-generation/templates"
DOCX_LOG_LEVEL=INFO

# --- Frontend build settings ---
VITE_PATIENT_BACKEND_URL=https://www.mdsystemtip.space
VITE_STAFF_BACKEND_URL=https://staff.mdsystemtip.space
VITE_GOOGLE_CLIENT_ID=
VITE_RECAPTCHA_SITE_KEY=

# --- Development-only flags ---
DEBUG_BYPASS_OTP=false
DEBUG_ALLOW_UNVERIFIED_TO_USE_SERVICES=false

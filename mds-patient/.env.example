# ============================================
# MDSystem Patient Portal — Environment Variables
# Copy this file to .env and adjust values as needed
# Vite exposes VITE_* vars to client-side code
# ============================================

# Developer Switch — which subdomain to simulate on localhost
# Options: 'www' | 'www2' (patient portal only)
# Used by: packages-core-adapter.js → packages/core api-base-url-provider
VITE_DEV_PORTAL=www

# Backend proxy target for Vite dev server (optional override)
# Auto-derived from VITE_DEV_PORTAL: www→www.mdsystemtip.space, www2→www2.mdsystemtip.space
# Set explicitly only to override (e.g. local backend: http://localhost:3000)
VITE_BACKEND_URL=https://www.mdsystemtip.space

# ── Dev-only bypasses (set to false in production) ──

# Bypass route authentication (skip token validation)
# Used by: src/routes/private-route.jsx
VITE_BYPASS_PRIVATE_ROUTE_AUTH=false

# ── Google OAuth & reCAPTCHA ──

# Google OAuth Client ID for Google Sign-In (tip.edu.ph accounts)
# Obtain from Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=

# reCAPTCHA v2 checkbox site key
# Obtain from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# Bypass initial medical record requirement
# Used by: src/pages/Dashboard.jsx
VITE_BYPASS_INITIAL_RECORD=false

# ── Layout config ──

# Google Sheets CSV URL for layout/route configuration
# Used by: scripts/fetch-sheets-config.js
# VITE_LAYOUT_ROUTES_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv

FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /tests
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/package.json
COPY mds-patient/package.json mds-patient/package.json
COPY mds-staff/package.json mds-staff/package.json
RUN npm ci --ignore-scripts
COPY Backend/package.json Backend/package-lock.json ./Backend/
RUN npm ci --prefix Backend --omit=dev --ignore-scripts
COPY playwright.config.js ./
COPY Backend/utils/validator.js ./Backend/utils/validator.js
COPY Backend/utils/totp.js ./Backend/utils/totp.js
COPY Backend/routes/emr/custom-choice-storage.js ./Backend/routes/emr/custom-choice-storage.js
COPY e2e ./e2e
ENV CI=1 E2E_CORE=1
CMD ["npm", "run", "test:gui", "--", "--project=core"]

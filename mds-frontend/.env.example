# IMPORTANT: API URL is automatically determined by the system
# - In development (localhost): Uses X-Forwarded-Host header to simulate subdomain
# - In production: Uses relative URLs to avoid CORS issues

# Developer Switch: 'www' for patient portal, 'staff' for staff portal
# This tells the frontend which domain to simulate when running on localhost
# Options: 'www', 'www2', 'staff', 'staff2'
# Used by: vite.config.js (proxy target), src/core.js (passed to packages/core via getEnv)
VITE_DEV_PORTAL=www

# Development Mode: Set to 'true' to bypass authentication (DEV ONLY)
# Used by: src/routes/private-route.jsx (Patient Portal)
VITE_BYPASS_PRIVATE_ROUTE_AUTH=false

# Bypass Staff Authentication: Set to 'true' to bypass staff portal authentication (DEV ONLY)
# When false (default): Staff must authenticate to access staff portal
# When true: Staff portal accessible without authentication
# Used by: src/App.jsx (Staff Portal)
VITE_BYPASS_STAFF_AUTH=false

# Bypass Initial Medical Record: Set to 'true' to skip initial medical record requirement
# When false (default): Users must complete initial record before accessing dashboard
# When true: Users can access dashboard without completing initial record
# Used by: src/pages/Dashboard.jsx
VITE_BYPASS_INITIAL_RECORD=true

# Layout Routes Sheet URL (publish as CSV from File > Share > Publish to web)
# Used by: scripts/fetch-sheets-config.js (fetches API endpoints and layout configuration)
# Replace YOUR_SHEET_ID and YOUR_GID with your actual Google Sheets IDs
VITE_LAYOUT_ROUTES_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv

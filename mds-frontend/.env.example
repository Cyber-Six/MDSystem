# IMPORTANT: API URL is automatically determined by the system
# - In development (localhost): Uses X-Forwarded-Host header to simulate subdomain
# - In production: Uses relative URLs to avoid CORS issues

# Developer Switch: 'www' for patient portal, 'staff' for staff portal
# This tells the frontend which domain to simulate when running on localhost
# Options: 'www', 'www2', 'staff', 'staff2'
# Used by: vite.config.js (proxy target), src/core.js (passed to packages/core via getEnv)
VITE_DEV_PORTAL=www2

# Development Mode: Set to 'true' to bypass authentication (DEV ONLY)
# Used by: src/routes/private-route.jsx
VITE_BYPASS_AUTH=false

# Google Sheets URLs (publish as CSV from File > Share > Publish to web)
# Used by: scripts/fetch-sheets-config.js (fetches API endpoints and layouts)
# Replace YOUR_SHEET_ID and YOUR_GID with your actual Google Sheets IDs
ENDPOINTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv
LAYOUTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv

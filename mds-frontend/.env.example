# MDSystem Frontend Environment Variables
# Copy this file to .env and fill in your values
# .env is git-ignored and will not be committed to the repository

# ============================================
# Local Development
# ============================================
# Backend API URL for local development
VITE_API_URL=http://localhost:3001

# ============================================
# Production URLs (mdsystemtip.space)
# ============================================
# Patient Portal API (www subdomain)
VITE_PATIENT_API_URL=https://www.mdsystemtip.space

# Staff Portal API (staff subdomain)
VITE_STAFF_API_URL=https://staff.mdsystemtip.space

# ============================================
# Google Sheets Configuration
# ============================================
# To get these URLs:
# 1. Open your Google Sheet
# 2. Go to File > Share > Publish to web
# 3. Choose the specific sheet/tab you want
# 4. Select "Comma-separated values (.csv)" as format
# 5. Click "Publish" and copy the URL

# API Endpoints Sheet URL
ENDPOINTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv

# Layouts Sheet URL
LAYOUTS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv

# ============================================
# Notes:
# ============================================
# - All variables must start with VITE_ to be accessible in the app
# - These are used by src/services/apiBaseUrlProvider.js
# - If not set, the app will use dynamic hostname detection as fallback
# - Sheet URLs are used by scripts/fetch-sheets-config.js to generate JSON configs
